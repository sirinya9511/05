rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidHazard(data) {
      return data.code is string && data.code.size() <= 64
        && data.activityName is string && data.activityName.size() <= 300
        && data.workArea is string && data.workArea.size() <= 200
        && data.hazardCategory is string && data.hazardCategory.size() <= 100
        && data.status is string && data.status.size() <= 50;
    }

    match /ra01_hazards/{hazardId} {
      allow read: if true;
      allow create: if isValidId(hazardId) && isValidHazard(request.resource.data);
      allow update: if isValidId(hazardId) && isValidHazard(request.resource.data);
      allow delete: if isValidId(hazardId);
    }

    // Connection test document
    match /test/{docId} {
      allow read, write: if true;
    }

    // Default deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
